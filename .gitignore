# Build output
/bin/
/dist/
*.exe
*.test

# Operator-supplied game files — never commit copyrighted binaries.
# manifest.json itself is just metadata (versions/checksums/file lists),
# not copyrighted content, so it's allowed through.
/profiles/*/*
!/profiles/*/manifest.json
!/profiles/.gitkeep

# Local config overrides
/configs/openbnls.json
/configs/*.local.json

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
